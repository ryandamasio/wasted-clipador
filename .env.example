# Copie para .env e preencha. NUNCA commite o .env real.

# Opcional: LLM barato para pontuar trechos e gerar títulos (claude-haiku-5-5).
# Deixe vazio para rodar 100% local (heurísticas + templates).
ANTHROPIC_API_KEY=

# Opcional: Twitch Helix (não necessário para captura/chat anônimo; só p/ metadados futuros)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Fase 3 — publicação automática (publish.mode: auto em settings.yaml). Tudo opcional: sem chave, a rede fica manual.
# Tokens que mudam (access/refresh) são renovados em data/tokens/<rede>.json (fora do git).

# YouTube Data API v3: Google Cloud > credenciais OAuth "App para computador"; depois `clipador publish auth youtube`
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok for Developers: Login Kit + Content Posting API (escopo video.publish); `clipador publish auth tiktok`
# App não auditado só posta em modo privado (SELF_ONLY): peça a auditoria quando o fluxo estiver estável.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Instagram Graph API (conta profissional ligada a uma Página; token de longa duração com
# instagram_business_content_publish). INSTAGRAM_USER_ID é o ID numérico da conta do Instagram.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Upload-Post (upload-post.com): alternativa com uma chave só para várias redes (via: upload-post)
UPLOAD_POST_API_KEY=
